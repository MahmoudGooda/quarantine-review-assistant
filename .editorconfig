root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cmd,ps1}]
end_of_line = crlf

# The runtime PowerShell scripts keep their UTF-8 BOM (Windows PowerShell 5.1 reads BOM-less files as ANSI).
[src/SecurityReview/app/*.ps1]
charset = utf-8-bom

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
